# BioTwin Backend Environment Variables
# Copy this file to .env and fill in the values

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration (optional - falls back to in-memory MockDB if not set)
MONGO_URI=mongodb://127.0.0.1:27017/biotwin
# legacy alias supported as well:
MONGODB_URI=mongodb://127.0.0.1:27017/biotwin

# JWT Configuration
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=24h

# AI Configuration
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-4o-mini
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2000

# External API Keys (for HMS/EHR integration)
HMS_API_KEY=
EHR_API_KEY=

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=info
